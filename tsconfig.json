{
  "extends": "./.github/linters/tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "target": "es2022",
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "node_modules",
    "./dist/**/*",
    "./tests/**/*",
    "./examples/**/*",
    "./scripts/**/*"
  ]
}
