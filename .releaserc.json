{
  "repositoryUrl": "git@github.com:centralnicgroup-opensource/rtldev-middleware-node-sdk.git",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@team-internet/semantic-release-plugins/replace",
      {
        "replacements": [
          {
            "files": ["./src/version.ts"],
            "from": "VERSION = \"\\d+\\.\\d+\\.\\d+\"",
            "to": "VERSION = \"${nextRelease.version}\"",
            "countMatches": true,
            "results": [
              {
                "file": "src/version.ts",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ]
          }
        ]
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package?(-lock).json", "src/version.ts"]
      }
    ],
    "@team-internet/semantic-release-plugins/teams-notify",
    "@semantic-release/github"
  ]
}
