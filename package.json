{
  "name": "@team-internet/apiconnector",
  "description": "Node.js SDK for the CentralNic Reseller (CNR, fka RRPProxy), Internet.bs (IBS) and Moniker registrar APIs",
  "version": "10.0.15",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Kai Schwarz",
    "email": "kai.schwarz@centralnic.com"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "//": "...",
  "license": "MIT",
  "homepage": "https://github.com/centralnicgroup-opensource/rtldev-middleware-node-sdk",
  "repository": "github:centralnicgroup-opensource/rtldev-middleware-node-sdk",
  "bugs": "https://github.com/centralnicgroup-opensource/rtldev-middleware-node-sdk/issues",
  "maintainers": [
    {
      "name": "Kai Schwarz",
      "email": "kai.schwarz@centralnic.com"
    },
    {
      "name": "Asif Nawaz",
      "email": "asif.nawaz@centralnic.com"
    }
  ],
  "engines": {
    "node": "^22.14.0 || >= 24.10.0"
  },
  "keywords": [
    "centralnicreseller",
    "centralnic",
    "cnic",
    "cnr",
    "reseller",
    "internet.bs",
    "ibs",
    "moniker",
    "sdk",
    "isp",
    "domain",
    "api",
    "connector",
    "ssl",
    "cert",
    "dns",
    "backorder",
    "premium",
    "preregistration",
    "registration",
    "application"
  ],
  "scripts": {
    "compile": "rm -rf dist && tsc --version && tsc --declaration",
    "lint": "prettier --check . --ignore-path .prettierignore && pnpm typecheck && pnpm eslint && pnpm fallow && pnpm run pack:check",
    "pack:check": "tsx scripts/pack-check.ts",
    "lint:fix": "prettier --write . --ignore-path .prettierignore && eslint . --fix",
    "eslint": "eslint . --max-warnings 0",
    "fallow": "fallow dead-code && fallow dupes",
    "prepare": "pnpm run compile",
    "documentation": "typedoc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "cross-env NODE_ENV=development c8 mocha",
    "test:record": "cross-env RTLDEV_MW_RECORD=1 cross-env NODE_ENV=development c8 mocha",
    "demo:cnr": "tsx examples/app_CNR.ts",
    "demo:ibs": "tsx examples/app_IBS.ts",
    "demo:moniker": "tsx examples/app_MONIKER.ts",
    "demo:datetime": "tsx examples/datetime.ts"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@team-internet/semantic-release-plugins": "^2.2.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "fallow": "3.17.0",
    "mocha": "^11.8.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "idna-uts46-hx": "^6.1.7",
    "undici": "^8.10.0"
  }
}
