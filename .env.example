# Copy to .env (gitignored) and fill in. Loaded automatically by the demo
# scripts via dotenv; CI exports the same names as repository secrets.
# Mirrors env.example.sh in the PHP SDK.

# CentralNic Reseller (CNR) credentials
RTLDEV_MW_CI_USER_CNR="<your-username>"
RTLDEV_MW_CI_USERPASSWORD_CNR="<your-password>"
# Role credentials — required for role-based access and the CNR demos
RTLDEV_MW_CI_ROLE_CNR="<your-role-name>"
RTLDEV_MW_CI_ROLEPASSWORD_CNR="<your-role-password>"

# Internet.bs (IBS) credentials
RTLDEV_MW_CI_USER_IBS="<your-username>"
RTLDEV_MW_CI_USERPASSWORD_IBS="<your-password>"

# Moniker credentials
RTLDEV_MW_CI_USER_MONIKER="<your-username>"
RTLDEV_MW_CI_USERPASSWORD_MONIKER="<your-password>"
